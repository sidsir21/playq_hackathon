# ============================================================================
# PlayQ environment. This file is git-ignored — never commit it or paste keys in chat.
# ============================================================================

# ── REQUIRED for the 1-day prototype (the ONLY key you must add) ────────────
# Create at https://aistudio.google.com/apikey  → "Create API key"
# Used for: rating card + Hinglish commentary + (optional) video check of the rally.
GEMINI_API_KEY=

# ── OPTIONAL: model overrides (defaults work; test_gemini.py shows valid IDs) ─
PLAYQ_GEMINI_MODEL=gemini-3.6-flash
PLAYQ_GEMINI_VIDEO_MODEL=gemini-3.6-flash
# Voiceover. Blank = auto-detect a *tts* model your key can use. Voice names: Kore, Puck, Charon, Fenrir...
PLAYQ_GEMINI_FALLBACK_MODEL=gemini-3.5-flash
PLAYQ_GEMINI_TIMEOUT_S=45
PLAYQ_GEMINI_TTS_MODEL=
PLAYQ_GEMINI_TTS_VOICE=Kore

# ── OPTIONAL: app settings (not read yet — added when the Streamlit app is built)
PLAYQ_MAX_UPLOAD_MB=300
PLAYQ_SPORT=pickleball

# ── NOT NEEDED TODAY: only for deploying to Google Cloud later ───────────────
# Leave blank. See the Google Cloud section of the plan.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-south1
GOOGLE_APPLICATION_CREDENTIALS=
PLAYQ_GCS_BUCKET=

# Local voice used when Gemini TTS is unavailable (macOS: Rishi, Tara, Aman are en-IN)
PLAYQ_FALLBACK_VOICE=Rishi

PLAYQ_GEMINI_MODEL_CHAIN=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
