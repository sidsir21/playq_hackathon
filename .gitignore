# PlayQ — Python
.venv/
__pycache__/
*.py[cod]
*$py.class
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/
*.egg-info/
*.egg

# Environment
.env
.env.*
!.env.example

